# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# env files (EXPO_PUBLIC_DEV_ACCESS_TOKEN must never be committed)
.env
.env.*
!.env.example

# test output
coverage/

# Rust Connect core (scripts/build-connect-core.sh output)
/native/connect-core/target/
/native/connect-core/build/

# Instance shell client (scripts/build-console-wasm.sh, scripts/build-console-web.mjs output)
/assets/console/

# Gradle output of local Expo modules
modules/*/android/build/
modules/*/android/.cxx/
