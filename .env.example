# Copy to .env.local (git-ignored). EXPO_PUBLIC_* values are inlined into the JS bundle.

# Build variant: staging (default) or production.
APP_VARIANT=staging

# OIDC client ID of the "Datum Cloud iOS" Zitadel app for this variant.
EXPO_PUBLIC_OIDC_CLIENT_ID=

# Optional: also end the Zitadel browser session on sign-out (default off).
# EXPO_PUBLIC_END_SESSION_ON_LOGOUT=true

# DEV ONLY (staging variant, __DEV__ builds): sign in with a pasted access token.
# Never set this for a release or production build.
# EXPO_PUBLIC_DEV_ACCESS_TOKEN=
